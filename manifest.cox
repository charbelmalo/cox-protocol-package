CoxVersion: "1.0"
FileType: "manifest"
Slug: "local_app_manager"
Schema: "cox.manifest.v1"
ProjectName: "LocalAppManager"
PackageName: "cox_protocol_package_corrected.zip"
ProtocolExtension: ".cox"
MimeType: "application/vnd.cox+yaml"
Encoding: "UTF-8"
SyntaxBase: "YAML-compatible structured text"
EntryPoint: "manifest.cox"
ReferenceDocs:
  - "CHANGELOG.md"
  - "FINALIZATION.md"
  - "README.md"
  - "COX_FILE_FORMAT_SPECIFICATION_v1.0.md"
GuideDocs:
  - "guides/contract-demo.md"
  - "guides/imported-packages/cox_protocol_package_compiled.md"
  - "guides/npm-installation.md"
ProtocolDocs:
  - "protocols/llm_agent_zip_recreation_instructions.cox"
  - "protocols/deterministic_naming_convention.cox"
  - "protocols/recursive_decomposition_protocol.cox"
  - "protocols/screenshot_partitioning_protocol.cox"
  - "protocols/evidence_and_uncertainty_protocol.cox"
  - "protocols/sub_agents_orchestration.cox"
  - "protocols/design_tokens.cox"
  - "protocols/component_binding_graph.cox"
  - "protocols/website_logic_and_functionality.cox"
  - "protocols/coding_agent_starting_point.cox"
  - "protocols/visual_acceptance_checklist.cox"
SkillBundles:
  - "skills/design-spec-writer"
  - "skills/package-docs-writer"
  - "skills/screenshot-semantic-namer"
  - "skills/visual-token-extractor"
  - "skills/zip-design-orchestrator"
  - "skills/zip-packager"
Schemas:
  - "schemas/cox.manifest.v1.schema.json"
  - "schemas/cox.page.v1.schema.json"
  - "schemas/cox.component.v1.schema.json"
  - "schemas/cox.protocol.v1.schema.json"
  - "schemas/cox.crop_metadata.v1.schema.json"
ToolingFiles:
  - "cox_protocol"
  - "scripts"
  - "tests"
  - "MANIFEST.in"
  - "LICENSE"
  - "package.json"
  - "bin/cox-protocol.js"
  - "pyproject.toml"
  - "requirements.txt"
  - "templates/ComponentName.cox.template"
  - "templates/Page.cox.template"
  - "templates/crop_metadata.cox.template"
  - "tools/__init__.py"
  - "tools/cox_cli.py"
  - "tools/cox_lib.py"
  - "tools/package_target.py"
  - "tools/react_target.py"
  - "editor-support/vscode/package.json"
  - "editor-support/vscode/language-configuration.json"
  - "editor-support/vscode/syntaxes/cox.tmLanguage.json"
  - "editor-support/vscode/.vscodeignore"
  - "editor-support/vscode/LICENSE"
  - "editor-support/vscode/README.md"
  - "editor-support/vscode/CHANGELOG.md"
  - "editor-support/vscode/snippets/cox-common.json"
  - "editor-support/vscode/snippets/cox-manifest.json"
  - "editor-support/vscode/snippets/cox-page.json"
  - "editor-support/vscode/snippets/cox-component.json"
  - "editor-support/vscode/snippets/cox-protocol.json"
  - "editor-support/vscode/snippets/cox-crop-metadata.json"
Pages:
  - PageName: "Dashboard"
    Slug: "dashboard"
    Folder: "LocalAppManager/Dashboard"
    PageInstruction: "LocalAppManager/Dashboard/dashboard.cox"
    PageScreenshotPlaceholder: "LocalAppManager/Dashboard/dashboard_screenshot.placeholder.txt"
    Components:
      - Slug: "left_navigation_sidebar"
        Folder: "LocalAppManager/Dashboard/left_navigation_sidebar"
        ComponentInstruction: "LocalAppManager/Dashboard/left_navigation_sidebar/left_navigation_sidebar.cox"
        ComponentScreenshotPlaceholder: "LocalAppManager/Dashboard/left_navigation_sidebar/left_navigation_sidebar_screenshot.placeholder.txt"
      - Slug: "top_header_stats_bar"
        Folder: "LocalAppManager/Dashboard/top_header_stats_bar"
        ComponentInstruction: "LocalAppManager/Dashboard/top_header_stats_bar/top_header_stats_bar.cox"
        ComponentScreenshotPlaceholder: "LocalAppManager/Dashboard/top_header_stats_bar/top_header_stats_bar_screenshot.placeholder.txt"
      - Slug: "projects_grid_cards"
        Folder: "LocalAppManager/Dashboard/projects_grid_cards"
        ComponentInstruction: "LocalAppManager/Dashboard/projects_grid_cards/projects_grid_cards.cox"
        ComponentScreenshotPlaceholder: "LocalAppManager/Dashboard/projects_grid_cards/projects_grid_cards_screenshot.placeholder.txt"
      - Slug: "analytics_sidebar_panels"
        Folder: "LocalAppManager/Dashboard/analytics_sidebar_panels"
        ComponentInstruction: "LocalAppManager/Dashboard/analytics_sidebar_panels/analytics_sidebar_panels.cox"
        ComponentScreenshotPlaceholder: "LocalAppManager/Dashboard/analytics_sidebar_panels/analytics_sidebar_panels_screenshot.placeholder.txt"
BuildTargets:
  - "json"
  - "react"
  - "package"
VerificationRules:
  - "Zip must contain this manifest."
  - "Every manifest-listed .cox file must exist on disk before compilation."
  - "Screenshots may be placeholders in this protocol package because no real screenshots were supplied in the request."
  - "When real screenshots are supplied, placeholders must be replaced by actual image files."
  - "Validation must parse YAML, apply JSON Schema, and check referenced paths."
