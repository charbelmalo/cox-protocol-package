{
  "name": "cox-protocol-package",
  "version": "1.2.0",
  "description": "NPM wrapper and distribution package for the COX protocol CLI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cox-protocol": "bin/cox-protocol.js"
  },
  "files": [
    "bin",
    "cox_protocol",
    "tools",
    "schemas",
    "protocols",
    "templates",
    "examples",
    "guides",
    "skills",
    "editor-support/vscode",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "COX_FILE_FORMAT_SPECIFICATION_v1.0.md",
    "manifest.cox",
    "LocalAppManager",
    "pyproject.toml",
    "requirements.txt",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/.cox-build.json",
    "!**/node_modules/**",
    "!**/build/**",
    "FINALIZATION.md",
    "scripts",
    "tests",
    "MANIFEST.in"
  ],
  "keywords": [
    "cox",
    "design-spec",
    "schema",
    "ui-reconstruction",
    "agent-protocol",
    "yaml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charbelmalo/cox-protocol-package.git"
  },
  "homepage": "https://github.com/charbelmalo/cox-protocol-package#readme",
  "bugs": {
    "url": "https://github.com/charbelmalo/cox-protocol-package/issues"
  },
  "scripts": {
    "test": "python3 -m pytest",
    "pack:dry-run": "npm pack --dry-run",
    "package:vscode": "npm --prefix editor-support/vscode run package",
    "smoke:python": "python3 scripts/release_check.py"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "7.0.2"
  }
}
